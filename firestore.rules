rules_version = '2';

// Roles (RBAC) for the /admin dashboard:
//   owner  – OWNER_EMAIL below; always an admin, can't be removed or demoted.
//   admin  – view, mark handled, export, delete enquiries; manage the team.
//   user   – view, mark handled, export enquiries.
// Team members live in /roles/{email} ({ role: 'admin' | 'user' }), managed
// from the dashboard's Team tab. Every signed-in account must have a verified
// email, so nobody can claim an invited address by registering it first.

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() {
      return 'medibytesinternational@gmail.com';
    }

    function verified() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return verified() && myEmail() == ownerEmail();
    }

    function myRole() {
      let path = /databases/$(database)/documents/roles/$(myEmail());
      return exists(path) ? get(path).data.role : null;
    }

    function isAdmin() {
      return isOwner() || (verified() && myRole() == 'admin');
    }

    function isStaff() {
      return isAdmin() || (verified() && myRole() == 'user');
    }

    // ---------- Enquiries (website form submissions) ----------
    match /enquiries/{id} {
      allow create: if validEnquiry(request.resource.data);
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'handled'];
      allow delete: if isAdmin();
    }

    // ---------- Team roles ----------
    match /roles/{email} {
      // Everyone can read their own role; admins see the whole team.
      allow read: if verified() && (email == myEmail() || isAdmin());
      // Admins manage everyone except themselves and the owner.
      allow create, update: if isAdmin()
        && email != myEmail()
        && email != ownerEmail()
        && email == email.lower()
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt'])
        && request.resource.data.role in ['admin', 'user']
        && request.resource.data.addedBy == myEmail()
        && request.resource.data.addedAt == request.time;
      allow delete: if isAdmin() && email != myEmail();
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function validEnquiry(d) {
      return d.keys().hasOnly(['form', 'fields', 'page', 'createdAt'])
        && d.createdAt == request.time
        && d.page is string && d.page.size() <= 200
        && d.fields is map
        && ((d.form == 'contact'
              && d.fields.keys().hasOnly(['name', 'email', 'message'])
              && d.fields.keys().hasAll(['name', 'email', 'message'])
              && shortString(d.fields.name, 200)
              && shortString(d.fields.email, 320)
              && shortString(d.fields.message, 5000))
          || (d.form == 'demo'
              && d.fields.keys().hasOnly(['name', 'email', 'facility', 'whatsapp'])
              && d.fields.keys().hasAll(['name', 'email', 'facility', 'whatsapp'])
              && shortString(d.fields.name, 200)
              && shortString(d.fields.email, 320)
              && shortString(d.fields.facility, 200)
              && shortString(d.fields.whatsapp, 40)));
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
