rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Website form submissions. The public site may only create well-formed
    // enquiries; admins (below) read them in the /admin dashboard, can mark
    // them handled and can delete them.
    match /enquiries/{id} {
      allow create: if validEnquiry(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'handled'];
    }

    // Accounts allowed into the dashboard. Each must also exist in Firebase
    // Authentication (email/password); add an email here and redeploy rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in [
          'medibytesinternational@gmail.com'
        ];
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function validEnquiry(d) {
      return d.keys().hasOnly(['form', 'fields', 'page', 'createdAt'])
        && d.createdAt == request.time
        && d.page is string && d.page.size() <= 200
        && d.fields is map
        && ((d.form == 'contact'
              && d.fields.keys().hasOnly(['name', 'email', 'message'])
              && d.fields.keys().hasAll(['name', 'email', 'message'])
              && shortString(d.fields.name, 200)
              && shortString(d.fields.email, 320)
              && shortString(d.fields.message, 5000))
          || (d.form == 'demo'
              && d.fields.keys().hasOnly(['name', 'email', 'facility', 'whatsapp'])
              && d.fields.keys().hasAll(['name', 'email', 'facility', 'whatsapp'])
              && shortString(d.fields.name, 200)
              && shortString(d.fields.email, 320)
              && shortString(d.fields.facility, 200)
              && shortString(d.fields.whatsapp, 40)));
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
